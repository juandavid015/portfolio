{
  "name": "portfolio",
  "version": "2026.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typegen": "next typegen",
    "typecheck": "pnpm typegen && tsc --noEmit",
    "lint": "pnpm typegen && eslint --max-warnings 0",
    "lint:fix": "pnpm typegen && eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck"
  },
  "dependencies": {
    "next": "16.4.0",
    "next-intl": "4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-better-tailwindcss": "4.9.0",
    "lefthook": "2.1.17",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
