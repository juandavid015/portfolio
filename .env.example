# Copy to `.env.local` for local overrides. All variables are optional.

# Public origin used for canonical URLs, Open Graph and the sitemap.
# Set it once the site has a custom domain. Without it, Vercel builds use the
# project's production URL and local builds use http://localhost:3000.
# SITE_URL=https://example.com

# Google Search Console ownership token: the `content` value of the
# "HTML tag" verification method. Rendered as
# <meta name="google-site-verification">; omitted when unset.
# GOOGLE_SITE_VERIFICATION=
